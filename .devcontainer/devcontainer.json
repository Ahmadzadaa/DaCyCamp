{
  "name": "DaCy Academy",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000, 4000],
  "portsAttributes": {
    "3000": { "label": "DaCy web", "onAutoForward": "openBrowser" },
    "4000": { "label": "DaCy API", "onAutoForward": "silent" }
  },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.28.0 --activate && pnpm install && (test -f .env || cp .env.example .env)",
  "customizations": {
    "vscode": {
      "extensions": ["Prisma.prisma", "bradlc.vscode-tailwindcss", "esbenp.prettier-vscode"]
    }
  }
}
