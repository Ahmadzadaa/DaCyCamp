# ───────── Verilənlər bazası ─────────
# A) docker compose (db servisi) və ya B) mövcud PostgreSQL — hər ikisi üçün eyni dəyişən
DATABASE_URL=postgresql://dacy:dacy@localhost:5432/dacy
# API e2e testləri üçün ayrıca baza (docker compose init.sql onu avtomatik yaradır)
DATABASE_URL_TEST=postgresql://dacy:dacy@localhost:5432/dacy_test

# ───────── Portlar (3100 və 5433 istifadə OLUNMUR) ─────────
WEB_PORT=3000
API_PORT=4000
DB_PORT=5432

# ───────── URL-lər ─────────
# Web serveri API-yə bu ünvanla gedir (docker compose --profile full: http://api:4000)
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# ───────── Auth ─────────
# Bu nümunə dəyərlər repo-da hamıya görünür. Production-da (NODE_ENV=production) API onlarla AÇILMIR:
# hər biri üçün ayrıca güclü açar yaradın: openssl rand -hex 32  (access, refresh və CTF_PEPPER fərqli olsun)
JWT_ACCESS_SECRET=deyisin-access-gizli-acar
JWT_REFRESH_SECRET=deyisin-refresh-gizli-acar
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# HTTPS arxasında true edin
COOKIE_SECURE=false

# ───────── CTF ─────────
# Cavab hash-ları üçün gizli "pepper" — dəyişsəniz köhnə cavablar yoxlanmaz
CTF_PEPPER=deyisin-ctf-pepper

# Pyodide (brauzerdə Python) paketlərinin ünvanı. Defolt: jsDelivr CDN (pandas, numpy, matplotlib daxil).
# İnternetsiz mühit üçün tam güzgünü öz serverinizə qoyub ünvanı verin (məs. /pyodide/ — yalnız nüvə kopyalanır).
# NEXT_PUBLIC_PYODIDE_URL=https://cdn.jsdelivr.net/pyodide/v0.29.5/full/

# ───────── Fayllar ─────────
STORAGE_DIR=./apps/api/storage
MAX_UPLOAD_MB=50
# Video dərslər (admin → kurs redaktoru → fəsildə «+ Video dərs») — diskə axınla yazılır
MAX_VIDEO_MB=2048

# ───────── Test / ilkin hesablar (seed-də upsert; boş = yaradılmır) ─────────
# Dəyərləri YALNIZ .env-də doldurun (koda yazmayın). Şifrələr bazada heş (argon2id) kimi saxlanılır.
# Tələbə hesabı avtomatik "NÜMUNƏ" kursuna yazılır.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_STUDENT_EMAIL=
SEED_STUDENT_PASSWORD=

# ───────── Digər ─────────
APP_TIMEZONE=Asia/Baku

# ── Terminal lab-ları (Mərhələ 3) ──────────────────────────────────────────
# LAB_DRIVER: off (defolt — lab-lar söndürülüb) | mock (Docker-siz test üçün virtual qabıq) |
#   docker (/var/run/docker.sock və ya DOCKER_HOST tələb edir — API-yə host üzərində səlahiyyət verir, SEC-06)
LAB_DRIVER=off
LAB_MAX_SESSIONS=20
LAB_MEMORY_MB=512
LAB_CPUS=0.5
LAB_PIDS_LIMIT=256
LAB_PULL=true
LAB_CHECK_TIMEOUT_SEC=60
# Brauzer terminal üçün WebSocket ünvanı (Next proksi WebSocket-i ötürmür). Boş = ws://<eyni host>:4000/labs/ws
# NEXT_PUBLIC_LAB_WS_URL=ws://localhost:4000/labs/ws
# Sertifikatın ictimai yoxlama linki üçün baza ünvan
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Akademiya modulu (qruplar, tapşırıqlar, qiymətləndirmə, dərs cədvəli). false — modul gizlənir və endpoint-lər 404 qaytarır
ACADEMY_MANAGEMENT_ENABLED=true
# Akademiya bildiriş işçisi (outbox, son tarix xatırlatmaları) — saniyə; 0 = söndürülüb
ACADEMY_WORKER_INTERVAL_SEC=30
# Akademiya faylının (tələbə göndərişi, tapşırıq resursu) ən böyük ölçüsü (MB)
ACADEMY_MAX_FILE_MB=20

# SQL/Python pilot: old terminal/CTF data stays stored, but is excluded from learning maps.
LEGACY_LABS_ENABLED=false
NEXT_PUBLIC_LEGACY_LABS=false
# Trust only the local Next proxy. For separate hosts, specify their actual addresses/subnets.
TRUST_PROXY=loopback

# Independent Python checking (Linux, bubblewrap, prlimit, and a Python environment).
# python3 -m venv .local/python && .local/python/bin/pip install -r ops/python-requirements.txt
PYTHON_BIN=/usr/bin/python3
PYTHON_SANDBOX_BIN=/usr/bin/bwrap
# Email: disabled | file (private local test inbox) | smtp
MAIL_TRANSPORT=disabled
MAIL_OUTBOX_DIR=.local/mail
MAIL_FROM="DaCy Academy <noreply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Automatic backup and monitoring are run by scripts/start.mjs.
BACKUP_INTERVAL_HOURS=24
# rclone remote:path; use a private rclone config. No remote delete/sync operation is used.
BACKUP_REMOTE=
RCLONE_BIN=rclone
PG_BIN=
OPERATIONS_ALERT_EMAIL=
