// apps/api/prisma/schema.prisma — DaCy Academy (Prisma 6, PostgreSQL)
//
// Content tree: Track > Course > Module > Step. Every level has `order` + `isPublished`.
// Stable keys: Course.slug (global), Module.key (per course), Step.key (per module). ZIP re-import upserts by
// these keys so Step.id — and therefore StepProgress — survives re-import. Items missing from a re-import are
// set isPublished=false (never hard-deleted by import). No soft-delete column: unique (parent, order) stays simple.
// Secrets: Step.secret (quiz correct/explanation, sql/python solution, sql expected result, terminal check_script,
// hints) and CtfTask.answerHash / CtfTask.hint are NEVER serialised to students. Step.config is public by construction.
// Progress: StepProgress is canonical. Enrollment.percent/completedAt, PathEnrollment.percent/completedAt and
// User.xpTotal are write-through caches recomputed in the same transaction (and by `recompute-progress`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── enums ─────────────────────────

/// TEACHER — akademiya müəllimi: qlobal heç bir hüquq vermir, yalnız təyin olunduğu qrupları görür.
/// INSTRUCTOR isə Camp məzmun heyətidir (kurs, mövzu, dəstək).
enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
  TEACHER
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum StepType {
  THEORY
  QUIZ
  SQL
  PYTHON
  TERMINAL
  CTF
}

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum AssetKind {
  IMAGE
  VIDEO
  PDF
  DATASET
  ATTACHMENT
  CHECK_SCRIPT // staff-only: never streamed to students
  OTHER
}

enum XpReason {
  STEP_COMPLETED
  CTF_TASK_SOLVED
  HINT_USED
  COURSE_COMPLETED
  PATH_ITEM_COMPLETED
  PATH_COMPLETED
  MANUAL
}

enum ImportStatus {
  VALIDATED
  FAILED
  APPLIED
}

enum LabStatus {
  STARTING
  RUNNING
  PASSED
  EXPIRED
  STOPPED
  FAILED
}

enum PathItemType {
  COURSE
  PROJECT
  ASSESSMENT
  MILESTONE
}

enum PathItemStatus {
  IN_PROGRESS
  SUBMITTED
  PASSED
  FAILED
}

// ───────────────────────── users & auth ─────────────────────────

model User {
  id                  String    @id @default(cuid())
  email               String    @unique // stored lower-cased
  passwordHash        String? // null = gələcəkdə Google OAuth ilə qeydiyyatdan keçən istifadəçi
  name                String
  role                Role      @default(STUDENT)
  avatarUrl           String?
  locale              String    @default("az")
  xpTotal             Int       @default(0) // cache of SUM(XpEvent.amount)
  targetPathId        String? // Phase 4 onboarding answer ("Hansı peşəyə hazırlaşırsınız?")
  weeklyGoal          Int       @default(8) // həftəlik hədəf (tapşırıq sayı) — sidebar və panel
  showOnLeaderboard   Boolean   @default(true) // liderlər cədvəlində görünmək (məxfilik)
  notificationsSeenAt DateTime? // zəng: bu andan yeni olanlar «oxunmamış» sayılır
  lastActiveAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  targetPath LearningPath? @relation("UserTargetPath", fields: [targetPathId], references: [id], onDelete: SetNull)

  refreshTokens     RefreshToken[]
  enrollments       Enrollment[]
  stepProgress      StepProgress[]
  submissions       Submission[]
  hintUsages        HintUsage[]
  ctfSolves         CtfSolve[]
  xpEvents          XpEvent[]
  activityDays      ActivityDay[]
  certificates      Certificate[]
  labSessions       LabSession[]
  pathEnrollments   PathEnrollment[]
  pathItemProgress  PathItemProgress[] @relation("PathItemProgressUser")
  reviewedPathItems PathItemProgress[] @relation("PathItemReviewer")
  pathCertificates  PathCertificate[]
  uploadedAssets    Asset[]            @relation("AssetUploader")
  courseImports     CourseImport[]
  createdCourses    Course[]           @relation("CourseCreator")
  deletedCourses    Course[]           @relation("CourseDeleter")
  stepUnlocks       StepUnlock[]       @relation("StepUnlockUser")
  grantedUnlocks    StepUnlock[]       @relation("StepUnlockGrantor")
  auditLogs         AuditLog[]
  roadmapChecks     RoadmapCheck[]
  supportTickets    SupportTicket[]
  supportMessages   SupportMessage[]

  // akademiya (yalnız əlaqə sahələri — sütun əlavə etmir)
  academyGroupsCreated      AcademyGroup[]               @relation("AcademyGroupCreator")
  academyInstructorRoles    AcademyGroupInstructor[]     @relation("AcademyInstructorUser")
  academyInstructorAssigned AcademyGroupInstructor[]     @relation("AcademyInstructorAssigner")
  academyEnrollments        AcademyEnrollment[]          @relation("AcademyEnrollmentStudent")
  academyEnrollmentsCreated AcademyEnrollment[]          @relation("AcademyEnrollmentCreator")
  academyEnrollmentEvents   AcademyEnrollmentEvent[]     @relation("AcademyEnrollmentEventActor")
  academyAssignmentsCreated AcademyAssignment[]          @relation("AcademyAssignmentCreator")
  academyAssignmentsEdited  AcademyAssignment[]          @relation("AcademyAssignmentEditor")
  academyExtensions         AcademyAssignmentExtension[] @relation("AcademyExtensionStudent")
  academyExtensionsApproved AcademyAssignmentExtension[] @relation("AcademyExtensionApprover")
  academyRevisions          AcademyAssignmentRevision[]  @relation("AcademyRevisionEditor")
  academySubmissions        AcademySubmission[]          @relation("AcademySubmissionStudent")
  academyDrafts             AcademySubmissionDraft[]     @relation("AcademyDraftStudent")
  academyFiles              AcademyFile[]                @relation("AcademyFileOwner")
  academyGradesGiven        AcademyGrade[]               @relation("AcademyGrader")
  academyGradeChanges       AcademyGradeHistory[]        @relation("AcademyGradeChanger")
  academySessionsTaught     AcademyClassSession[]        @relation("AcademySessionInstructor")
  academySessionsCreated    AcademyClassSession[]        @relation("AcademySessionCreator")
  academyAttendance         AcademyAttendance[]          @relation("AcademyAttendanceStudent")
  academyAttendanceMarked   AcademyAttendance[]          @relation("AcademyAttendanceMarker")
  academyNotifications      AcademyNotification[]        @relation("AcademyNotificationUser")
}

/// Rotating refresh tokens; only the sha256 hash is stored.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ───────────────────────── content tree ─────────────────────────

model Track {
  id          String   @id @default(cuid())
  slug        String   @unique // data-analytics | data-engineering | cyber-security (seeded, editable)
  title       String
  description String?
  /// Tərcümələr: {"en": {...}} — oxuyanda dil İngiliscədirsə mətn sahələrinin üzərinə yazılır (admin marşrutlarında yox)
  i18n        Json?
  color       String // hex, e.g. #6C7CF0 — every badge / card top / progress bar reads this
  icon        String? // lucide icon name
  order       Int      @unique
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses  Course[]
  paths    LearningPath[]
  roadmaps Roadmap[]
}

/// Mövzu (Qeyd 5): istiqamətdən əlavə başlıq — məs. «Python», «Excel», «Linux». Kurs bir neçə mövzuya aid ola bilər.
model Topic {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  /// Tərcümələr: {"en": {...}} — oxuyanda dil İngiliscədirsə mətn sahələrinin üzərinə yazılır (admin marşrutlarında yox)
  i18n        Json?
  color       String   @default("#6C7CF0")
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[] @relation("CourseTopics")

  @@index([isPublished, order])
}

model Course {
  id                 String    @id @default(cuid())
  trackId            String
  slug               String    @unique // globally unique; ZIP re-import key
  title              String
  level              Level     @default(BEGINNER)
  description        String    @default("")
  /// Tərcümələr: {"en": {...}} — oxuyanda dil İngiliscədirsə mətn sahələrinin üzərinə yazılır (admin marşrutlarında yox)
  i18n               Json?
  coverAssetId       String?
  sequential         Boolean   @default(true) // false = free navigation
  estimatedHours     Float?
  order              Int
  isPublished        Boolean   @default(false)
  publishedAt        DateTime?
  createdById        String?
  importedAt         DateTime? // last ZIP import
  /// Kartda və kurs səhifəsində göstərilən müəllim (admin paneldən doldurulur)
  instructorName     String?
  instructorTitle    String?
  instructorAvatarId String?
  /// Arxiv: kataloqdan gizlənir, yazılmış tələbələr davam edir
  archivedAt         DateTime?
  /// Soft delete: "Silinənlər" (30 gün), sonra həmişəlik silinir
  deletedAt          DateTime?
  deletedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  track            Track  @relation(fields: [trackId], references: [id], onDelete: Restrict)
  cover            Asset? @relation("CourseCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  instructorAvatar Asset? @relation("CourseInstructorAvatar", fields: [instructorAvatarId], references: [id], onDelete: SetNull)
  createdBy        User?  @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deletedBy        User?  @relation("CourseDeleter", fields: [deletedById], references: [id], onDelete: SetNull)

  modules      Module[]
  assets       Asset[]             @relation("CourseAssets")
  enrollments  Enrollment[]
  certificates Certificate[]
  imports      CourseImport[]
  xpEvents     XpEvent[]
  pathItems    PathItem[] // the same course may appear in many learning paths
  topics       Topic[]             @relation("CourseTopics") // mövzular (Qeyd 5) — istiqamətdən əlavə etiketlər
  academyLinks AcademyCourseLink[] @relation("AcademyCourseLinks")

  @@unique([trackId, order])
  @@index([isPublished, level])
  @@index([deletedAt])
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  key         String // stable key: folder name minus numeric prefix ("01-giris" -> "giris")
  title       String
  description String?
  /// Tərcümələr: {"en": {...}} — oxuyanda dil İngiliscədirsə mətn sahələrinin üzərinə yazılır (admin marşrutlarında yox)
  i18n        Json?
  order       Int
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  steps  Step[]

  @@unique([courseId, key])
  @@unique([courseId, order])
}

model Step {
  id               String   @id @default(cuid())
  moduleId         String
  key              String // stable key: file name minus prefix/extension ("03-select.yaml" -> "select")
  type             StepType
  title            String
  /// PUBLIC part, YAML keys verbatim (snake_case). Validated by zod per type on every write. Never contains secrets.
  config           Json     @default("{}")
  /// SERVER-ONLY part: quiz {questions[].correct, explanation}, sql {solution, expected, hints}, python {solution, hints},
  /// terminal {check_script, hints}. Never selected by student endpoints.
  secret           Json?
  /// Tərcümələr: {"en": {...}} — oxuyanda dil İngiliscədirsə mətn sahələrinin üzərinə yazılır (admin marşrutlarında yox)
  i18n             Json?
  /// secret-in tərcüməsi (ipucları, izahlar) — yalnız secret seçiləndə üzərinə yazılır
  secretI18n       Json?
  xp               Int      @default(0)
  estimatedMinutes Int?
  order            Int
  isPublished      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  module            Module                  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  ctfTasks          CtfTask[]
  progress          StepProgress[]
  submissions       Submission[]
  hintUsages        HintUsage[]
  xpEvents          XpEvent[]
  labSessions       LabSession[]
  unlocks           StepUnlock[]
  lastOfEnrollments Enrollment[]            @relation("EnrollmentLastStep")
  academyItems      AcademyAssignmentItem[] @relation("AcademyItemStep")

  @@unique([moduleId, key])
  @@unique([moduleId, order])
  @@index([type])
}

/// One row per CTF question. answerHash = HMAC-SHA256(CTF_PEPPER, normalise(answer)); plaintext is discarded on write.
model CtfTask {
  id            String  @id @default(cuid())
  stepId        String
  key           String // stable ("t1".."tn" by default, author-provided allowed)
  order         Int
  question      String // Markdown
  hint          String? // revealed only via the hint endpoint
  /// Tərcümələr: {"en": {...}} — oxuyanda dil İngiliscədirsə mətn sahələrinin üzərinə yazılır (admin marşrutlarında yox)
  i18n          Json?
  points        Int     @default(0)
  caseSensitive Boolean @default(false)
  answerHash    String

  step     Step       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  solves   CtfSolve[]
  xpEvents XpEvent[]

  @@unique([stepId, key])
  @@unique([stepId, order])
}

/// Uploaded course files. `path` mirrors the ZIP layout (datasets/sales.csv, cover.png, checks/etl_check.sh, logs/auth.log).
/// Every asset belongs to a course (no global assets), so (courseId, path) is a real uniqueness guarantee.
model Asset {
  id           String    @id @default(cuid())
  courseId     String
  path         String
  kind         AssetKind
  filename     String
  mime         String
  sizeBytes    Int
  sha256       String
  storageKey   String    @unique // key in the storage adapter (local disk in Phase 1)
  uploadedById String?
  createdAt    DateTime  @default(now())

  course     Course   @relation("CourseAssets", fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("AssetUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  coverOf    Course[] @relation("CourseCover")
  avatarOf   Course[] @relation("CourseInstructorAvatar")

  @@unique([courseId, path])
  @@index([kind])
  @@index([sha256])
}

/// Phase 2 ZIP import audit log.
model CourseImport {
  id           String       @id @default(cuid())
  courseId     String?
  slug         String
  filename     String
  status       ImportStatus
  /// { errors: [{file, path, message}], summary: {modules, steps, assets, created, updated, unpublished} }
  report       Json
  uploadedById String?
  createdAt    DateTime     @default(now())

  course     Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([courseId, createdAt])
  @@index([slug, createdAt])
}

// ───────────────────────── learning / progress ─────────────────────────

model Enrollment {
  id             String    @id @default(cuid())
  userId         String
  courseId       String
  enrolledAt     DateTime  @default(now())
  lastStepId     String? // "Qaldığınız yer"
  lastActivityAt DateTime  @default(now())
  percent        Int       @default(0) // cache; canonical value derived from StepProgress
  completedAt    DateTime? // cache; set once when derived progress first reaches 100 %

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lastStep Step?  @relation("EnrollmentLastStep", fields: [lastStepId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId, lastActivityAt])
}

/// Canonical progress. One row per (user, step) once opened. Absence = not started.
model StepProgress {
  id            String         @id @default(cuid())
  userId        String
  stepId        String
  status        ProgressStatus @default(IN_PROGRESS)
  attempts      Int            @default(0)
  score         Float? // best score (quiz %, ctf points share)
  startedAt     DateTime       @default(now())
  lastAttemptAt DateTime?
  completedAt   DateTime?
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([userId, stepId])
  @@index([stepId, status])
  @@index([userId, status])
  @@index([userId, completedAt])
}

/// Every graded attempt. CTF answers are never stored (only the task key).
model Submission {
  id         String   @id @default(cuid())
  userId     String
  stepId     String
  type       StepType
  /// quiz: {answers: number[][]} | sql: {query, row_hash, row_count} | python: {code, stdout} | ctf: {taskKey} | terminal: {checkOutput}
  payload    Json
  /// what the student saw: quiz {score, passed, per_question[]} | sql/python {passed, message} — never contains secrets
  result     Json?
  passed     Boolean  @default(false)
  score      Float?
  durationMs Int?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)

  academyEvidence AcademySubmissionItem[] @relation("AcademyEvidence")

  @@index([userId, stepId, createdAt])
  @@index([stepId, passed])
}

/// Admin tələbəyə ardıcıl kursda kilidli addımı əl ilə açır (kilid hesablamasında "available" sayılır).
model StepUnlock {
  id           String   @id @default(cuid())
  userId       String
  stepId       String
  unlockedById String?
  createdAt    DateTime @default(now())

  user       User  @relation("StepUnlockUser", fields: [userId], references: [id], onDelete: Cascade)
  step       Step  @relation(fields: [stepId], references: [id], onDelete: Cascade)
  unlockedBy User? @relation("StepUnlockGrantor", fields: [unlockedById], references: [id], onDelete: SetNull)

  @@unique([userId, stepId])
}

/// Admin əməliyyatlarının jurnalı: kim, nəyi, nə vaxt. Obyekt silinsə də sətir qalır (başlıq snapshot-dur).
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorEmail  String // snapshot
  action      String // course.archive, step.update, enrollment.reset, ...
  entityType  String // COURSE | MODULE | STEP | ASSET | TRACK | USER | ENROLLMENT
  entityId    String?
  entityTitle String?
  courseId    String? // kurs daxilində filtr üçün (FK deyil — kurs silinəndə tarixçə qalır)
  details     Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([courseId, createdAt])
  @@index([actorId, createdAt])
}

/// hintKey = "h:<index>" for step hints (sql/python/terminal) or "t:<ctfTaskKey>" for CTF task hints.
model HintUsage {
  id        String   @id @default(cuid())
  userId    String
  stepId    String
  hintKey   String
  xpPenalty Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([userId, stepId, hintKey])
}

model CtfSolve {
  id        String   @id @default(cuid())
  userId    String
  ctfTaskId String
  attempts  Int      @default(1)
  solvedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ctfTask CtfTask @relation(fields: [ctfTaskId], references: [id], onDelete: Cascade)

  @@unique([userId, ctfTaskId])
}

/// Append-only XP ledger. dedupeKey ("step:<id>", "ctf:<taskId>", "hint:<stepId>:<hintKey>", "course:<id>", "path:<id>")
/// makes every grant idempotent. Content references are SetNull so XP history survives content deletion.
model XpEvent {
  id         String   @id @default(cuid())
  userId     String
  amount     Int // negative for hint penalties
  reason     XpReason
  stepId     String?
  ctfTaskId  String?
  courseId   String?
  pathItemId String?
  pathId     String?
  dedupeKey  String?
  createdAt  DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  step     Step?         @relation(fields: [stepId], references: [id], onDelete: SetNull)
  ctfTask  CtfTask?      @relation(fields: [ctfTaskId], references: [id], onDelete: SetNull)
  course   Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  pathItem PathItem?     @relation(fields: [pathItemId], references: [id], onDelete: SetNull)
  path     LearningPath? @relation(fields: [pathId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}

/// One row per user per calendar day in APP_TIMEZONE (default Asia/Baku); powers streak + week strip.
model ActivityDay {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @db.Date
  xp             Int      @default(0)
  stepsCompleted Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/// Phase 3. id is the public verification id (/sertifikat/[id]); snapshot freezes names so deletion of the course never breaks the page.
model Certificate {
  id           String                  @id @default(uuid())
  /// ardıcıl nömrə → serial (DACY-C-2026-000001)
  seq          Int                     @unique @default(autoincrement())
  serial       String                  @unique // DACY-C-2026-000001
  userId       String
  courseId     String?
  /// { studentName, courseTitle, trackTitle, trackColor, hours, xp }
  snapshot     Json
  issuedAt     DateTime                @default(now())
  revokedAt    DateTime?
  /// PENDING — kurs brauzerdə yoxlanılan (CLIENT_ATTESTED) Python addımlarına əsaslanır, admin təsdiqi gözləyir
  reviewStatus CertificateReviewStatus @default(APPROVED)
  reviewedAt   DateTime?
  reviewedById String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([reviewStatus])
}

/// Sertifikatın etibarlılıq yoxlaması (SEC-04): brauzerin bildirdiyi nəticəyə əsaslananlar təsdiqə qədər PENDING
enum CertificateReviewStatus {
  PENDING
  APPROVED
}

/// Phase 3 terminal labs: one isolated container per student per step.
model LabSession {
  id          String    @id @default(cuid())
  userId      String
  stepId      String
  status      LabStatus @default(STARTING)
  image       String
  containerId String?
  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  endedAt     DateTime?
  passedAt    DateTime?
  checkOutput String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([userId, stepId, status])
  @@index([status, expiresAt])
}

// ───────────────────────── learning paths (Phase 4 — schema ready now) ─────────────────────────

model LearningPath {
  id             String   @id @default(cuid())
  trackId        String
  slug           String   @unique // "data-analyst"
  title          String // "Data Analyst ol"
  description    String   @default("")
  /// Tərcümələr: {"en": {...}} — oxuyanda dil İngiliscədirsə mətn sahələrinin üzərinə yazılır (admin marşrutlarında yox)
  i18n           Json?
  level          Level    @default(BEGINNER)
  targetAudience String?
  skills         String[] @default([])
  estimatedHours Float?
  sequential     Boolean  @default(true)
  order          Int
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  track        Track             @relation(fields: [trackId], references: [id], onDelete: Restrict)
  items        PathItem[]
  enrollments  PathEnrollment[]
  certificates PathCertificate[]
  xpEvents     XpEvent[]
  targetedBy   User[]            @relation("UserTargetPath")

  @@unique([trackId, order])
  @@index([isPublished])
}

model PathItem {
  id             String       @id @default(cuid())
  pathId         String
  key            String // stable: course slug for COURSE items, author slug for others (from path.yaml)
  order          Int
  type           PathItemType
  courseId       String? // COURSE items only; no path FK on Course, so a course can sit in many paths
  title          String? // PROJECT/ASSESSMENT/MILESTONE (COURSE items use course.title)
  /// PROJECT {instructions, deliverables[], review_mode} | ASSESSMENT quiz public config | MILESTONE {certificate_title, description} | COURSE {}
  config         Json         @default("{}")
  secret         Json? // ASSESSMENT correct answers / explanations
  /// Tərcümələr: {"en": {...}} — oxuyanda dil İngiliscədirsə mətn sahələrinin üzərinə yazılır (admin marşrutlarında yox)
  i18n           Json?
  secretI18n     Json?
  isOptional     Boolean      @default(false)
  estimatedHours Float?
  xp             Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  path              LearningPath       @relation(fields: [pathId], references: [id], onDelete: Cascade)
  course            Course?            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  progress          PathItemProgress[]
  xpEvents          XpEvent[]
  lastOfEnrollments PathEnrollment[]   @relation("PathEnrollmentLastItem")

  @@unique([pathId, key])
  @@unique([pathId, order])
  @@index([courseId])
}

model PathEnrollment {
  id          String    @id @default(cuid())
  userId      String
  pathId      String
  isActive    Boolean   @default(true) // the path shown on top of /panel
  enrolledAt  DateTime  @default(now())
  lastItemId  String?
  percent     Int       @default(0) // cache; canonical value derived
  completedAt DateTime? // cache

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  path     LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  lastItem PathItem?    @relation("PathEnrollmentLastItem", fields: [lastItemId], references: [id], onDelete: SetNull)

  @@unique([userId, pathId])
  @@index([userId, isActive])
}

/// State for NON-course items only (project / assessment / milestone). COURSE items derive from StepProgress.
model PathItemProgress {
  id           String         @id @default(cuid())
  userId       String
  pathItemId   String
  status       PathItemStatus @default(IN_PROGRESS)
  score        Float?
  attempts     Int            @default(0)
  payload      Json? // project: {files: [{storageKey, filename, size}], link?, note} | assessment: {answers}
  feedback     String?
  reviewedById String?
  submittedAt  DateTime?
  completedAt  DateTime?
  updatedAt    DateTime       @updatedAt

  user       User     @relation("PathItemProgressUser", fields: [userId], references: [id], onDelete: Cascade)
  pathItem   PathItem @relation(fields: [pathItemId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("PathItemReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([userId, pathItemId])
  @@index([pathItemId, status])
}

model PathCertificate {
  id           String                  @id @default(uuid())
  /// ardıcıl nömrə → serial (DACY-P-2026-000001)
  seq          Int                     @unique @default(autoincrement())
  serial       String                  @unique // DACY-P-2026-000001
  userId       String
  pathId       String?
  /// { studentName, pathTitle, trackTitle, trackColor, hours }
  snapshot     Json
  issuedAt     DateTime                @default(now())
  revokedAt    DateTime?
  /// PENDING — yoldakı kurslarda brauzerdə yoxlanılan Python addımları var, admin təsdiqi gözləyir
  reviewStatus CertificateReviewStatus @default(APPROVED)
  reviewedAt   DateTime?
  reviewedById String?

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  path LearningPath? @relation(fields: [pathId], references: [id], onDelete: SetNull)

  @@unique([userId, pathId])
  @@index([reviewStatus])
}

/// Karyera xəritəsi: peşə → səviyyələr → bacarıq qrupları → bacarıqlar (content JSON, shared roadmapContentSchema).
/// Məzmunu yalnız ADMIN dəyişir.
model Roadmap {
  id          String   @id @default(cuid())
  slug        String   @unique // data-engineer
  title       String
  tagline     String?
  description String?
  trackId     String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  content     Json
  /// Tərcümələr: {"en": {...}} — oxuyanda dil İngiliscədirsə mətn sahələrinin üzərinə yazılır (admin marşrutlarında yox)
  i18n        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  track  Track?         @relation(fields: [trackId], references: [id], onDelete: SetNull)
  checks RoadmapCheck[]

  @@index([isPublished, order])
}

/// Tələbənin «bunu bilirəm» işarəsi (özünüqiymətləndirmə). skillId — content daxilindəki sabit id.
model RoadmapCheck {
  userId    String
  roadmapId String
  skillId   String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@id([userId, roadmapId, skillId])
  @@index([roadmapId])
}

/// Sayt ayarları (açar → JSON), məs. «levels» — səviyyə adları. Yalnız ADMIN dəyişir.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────── Dəstək: tələbə müraciət yazır, heyət cavablandırır ─────────
enum SupportStatus {
  OPEN // cavab gözləyir
  ANSWERED // heyət cavab verib
  CLOSED
}

model SupportTicket {
  id            String           @id @default(cuid())
  userId        String
  subject       String
  status        SupportStatus    @default(OPEN)
  /// müraciət yazılan səhifə (istəyə bağlı) — heyətə kontekst
  pageUrl       String?
  lastMessageAt DateTime         @default(now())
  /// tələbə müraciətə son baxış — oxunmamış cavab göstəricisi
  userSeenAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([userId, lastMessageAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  authorId  String?
  fromStaff Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

// ═════════════════════════ AKADEMİYA (müəllim rəhbərliyi ilə təhsil) ═════════════════════════
// Əlavə modul: mövcud cədvəllər dəyişmir. Ballar yüzdə bir bal ilə (Int, …Centi). Vaxtlar UTC.
// Kompozit xarici açarlar invariantları bazada təmin edir: cavab yalnız eyni tapşırığın elementinə,
// qiymət yalnız öz göndərişinin cəhdinə, göndəriş / davamiyyət / uzadılma yalnız qrupa yazılmış tələbəyə aid ola bilər.
// Ətraflı: docs/academy-management/DATABASE.md

enum AcademyProgramStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AcademyGroupStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum AcademyLearningFormat {
  ONLINE
  OFFLINE
  HYBRID
}

enum AcademyInstructorRole {
  LEAD
  ASSISTANT
}

enum AcademyEnrollmentStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  WITHDRAWN
}

enum AcademyAssignmentType {
  EXISTING_CHALLENGE
  CUSTOM_TASK
  CODING_TASK
  FILE_BASED
  LAB
  PROJECT
}

enum AcademyAssignmentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
  CANCELLED
}

enum AcademyGradingType {
  AUTOMATIC
  MANUAL
  HYBRID
}

enum AcademyLatePolicy {
  REJECT
  ACCEPT
  ACCEPT_WITH_PENALTY
}

enum AcademyAttemptSelection {
  LATEST_ATTEMPT
  HIGHEST_SCORE
  INSTRUCTOR_SELECTED
}

enum AcademyItemKind {
  LEARNING_STEP
  TEXT
  CODE
  FILE
  LINK
}

enum AcademyEvaluationTrust {
  SERVER_VERIFIED
  SERVER_CHECKED
  CLIENT_ATTESTED
  COMPLETION
}

enum AcademyEvaluationStatus {
  NOT_APPLICABLE
  PENDING
  COMPLETED
  FAILED
}

enum AcademyGradeStatus {
  DRAFT
  RELEASED
  RETURNED
}

enum AcademyClassStatus {
  SCHEDULED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum AcademyAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AcademyFilePurpose {
  ASSIGNMENT_RESOURCE
  SUBMISSION
}

enum AcademyFileStatus {
  STAGED // yüklənib, hələ heç nəyə bağlanmayıb (təmizləmə işi köhnələri silir)
  ATTACHED
}

enum AcademyOutboxStatus {
  PENDING
  DONE
  FAILED
}

/// Təhsil istiqaməti (Data Engineering, Cyber Security). Platformanın Track-indən ayrıdır.
model AcademyProgram {
  id          String               @id @default(cuid())
  title       String
  slug        String               @unique
  description String               @default("")
  status      AcademyProgramStatus @default(DRAFT)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  groups AcademyGroup[]
}

/// Konkret qrup (kohort), məs. DE-001
model AcademyGroup {
  id          String                @id @default(cuid())
  programId   String
  code        String                @unique
  name        String
  description String                @default("")
  status      AcademyGroupStatus    @default(PLANNED)
  format      AcademyLearningFormat @default(ONLINE)
  timezone    String                @default("Asia/Baku")
  capacity    Int?
  startAt     DateTime?
  endAt       DateTime?
  /// Qoşulma kodu: tələbə qeydiyyatda yazır və birbaşa bu qrupa düşür. Təsadüfi, təxmin edilmir; admin yeniləyə bilər
  joinCode    String                @unique
  joinEnabled Boolean               @default(true)
  createdById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  program     AcademyProgram           @relation(fields: [programId], references: [id], onDelete: Restrict)
  createdBy   User?                    @relation("AcademyGroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  instructors AcademyGroupInstructor[]
  enrollments AcademyEnrollment[]
  courseLinks AcademyCourseLink[]
  assignments AcademyAssignment[]
  sessions    AcademyClassSession[]

  @@index([programId, status])
}

/// Müəllim ↔ qrup. removedAt — əlaqə bitib (tarix qalır). leadSlot = groupId yalnız aktiv aparıcı üçün:
/// unikal sütun qrupda ən çox bir aktiv aparıcı müəllimi bazada təmin edir (NULL-lar təkrarlana bilər).
model AcademyGroupInstructor {
  id           String                @id @default(cuid())
  groupId      String
  userId       String
  role         AcademyInstructorRole
  leadSlot     String?               @unique
  assignedAt   DateTime              @default(now())
  removedAt    DateTime?
  assignedById String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  group      AcademyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User         @relation("AcademyInstructorUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?        @relation("AcademyInstructorAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([groupId, userId])
  @@index([userId, removedAt])
}

/// Tələbə ↔ qrup. Bir (qrup, tələbə) üçün bir sətir; vəziyyət keçidləri AcademyEnrollmentEvent-də.
model AcademyEnrollment {
  id          String                  @id @default(cuid())
  groupId     String
  studentId   String
  status      AcademyEnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime                @default(now())
  endedAt     DateTime?
  createdById String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  group       AcademyGroup                 @relation(fields: [groupId], references: [id], onDelete: Restrict)
  student     User                         @relation("AcademyEnrollmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  createdBy   User?                        @relation("AcademyEnrollmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  events      AcademyEnrollmentEvent[]
  submissions AcademySubmission[]
  drafts      AcademySubmissionDraft[]
  extensions  AcademyAssignmentExtension[]
  attendance  AcademyAttendance[]

  @@unique([groupId, studentId])
  @@index([studentId, status])
}

model AcademyEnrollmentEvent {
  id           String                   @id @default(cuid())
  enrollmentId String
  fromStatus   AcademyEnrollmentStatus?
  toStatus     AcademyEnrollmentStatus
  reason       String?
  actorId      String?
  createdAt    DateTime                 @default(now())

  enrollment AcademyEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  actor      User?             @relation("AcademyEnrollmentEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([enrollmentId, createdAt])
}

/// Qrupun izlədiyi mövcud platforma kursu (məzmun kopyalanmır)
model AcademyCourseLink {
  id        String   @id @default(cuid())
  groupId   String
  courseId  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  group  AcademyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  course Course       @relation("AcademyCourseLinks", fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([groupId, courseId])
}

model AcademyAssignment {
  id                 String                  @id @default(cuid())
  groupId            String
  title              String
  description        String                  @default("")
  type               AcademyAssignmentType
  status             AcademyAssignmentStatus @default(DRAFT)
  availableAt        DateTime
  dueAt              DateTime
  lateCutoffAt       DateTime?
  latePolicy         AcademyLatePolicy       @default(REJECT)
  latePenaltyPercent Int                     @default(0)
  maxAttempts        Int                     @default(3)
  maxScoreCenti      Int
  gradingType        AcademyGradingType      @default(MANUAL)
  attemptSelection   AcademyAttemptSelection @default(LATEST_ATTEMPT)
  deliverables       String[]                @default([])
  version            Int                     @default(1)
  publishedAt        DateTime?
  createdById        String?
  updatedById        String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  group       AcademyGroup                 @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdBy   User?                        @relation("AcademyAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?                        @relation("AcademyAssignmentEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  items       AcademyAssignmentItem[]
  extensions  AcademyAssignmentExtension[]
  revisions   AcademyAssignmentRevision[]
  submissions AcademySubmission[]
  drafts      AcademySubmissionDraft[]
  files       AcademyFile[]
  rubric      AcademyRubric?

  @@unique([id, groupId])
  @@index([groupId, status, dueAt])
}

/// Tapşırığın elementi: mövcud platforma addımına istinad (kopya deyil) və ya akademiyaya xas tapşırıq.
/// sourceSnapshot — əlavə edildiyi andakı mənbə (addım silinsə / dəyişsə tarix pozulmur), sourceVersion — Step.updatedAt.
model AcademyAssignmentItem {
  id             String          @id @default(cuid())
  assignmentId   String
  kind           AcademyItemKind
  stepId         String?
  sourceVersion  String?
  sourceSnapshot Json?
  title          String
  description    String          @default("")
  maxScoreCenti  Int
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  assignment AcademyAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  step       Step?                   @relation("AcademyItemStep", fields: [stepId], references: [id], onDelete: SetNull)
  answers    AcademySubmissionItem[]
  itemScores AcademyGradeItem[]

  @@unique([id, assignmentId])
  @@index([assignmentId, sortOrder])
  @@index([stepId])
}

/// Fərdi son tarix (bir tələbə). Tələbə qrupa yazılmalıdır — (groupId, studentId) → AcademyEnrollment.
model AcademyAssignmentExtension {
  id            String   @id @default(cuid())
  assignmentId  String
  groupId       String
  studentId     String
  extendedDueAt DateTime
  reason        String
  approvedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignment AcademyAssignment @relation(fields: [assignmentId, groupId], references: [id, groupId], onDelete: Cascade)
  enrollment AcademyEnrollment @relation(fields: [groupId, studentId], references: [groupId, studentId], onDelete: NoAction, onUpdate: NoAction)
  student    User              @relation("AcademyExtensionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  approvedBy User?             @relation("AcademyExtensionApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
}

/// Dərc olunmuş tapşırığın versiyaları: hər mənalı dəyişiklik snapshot + redaktor + səbəb
model AcademyAssignmentRevision {
  id           String   @id @default(cuid())
  assignmentId String
  version      Int
  snapshot     Json
  changes      String[] @default([])
  reason       String?
  editedById   String?
  createdAt    DateTime @default(now())

  assignment AcademyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  editedBy   User?             @relation("AcademyRevisionEditor", fields: [editedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, version])
}

/// Tələbə × tapşırıq konteyneri (0 və ya daha çox cəhd)
model AcademySubmission {
  id           String   @id @default(cuid())
  assignmentId String
  groupId      String
  studentId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment AcademyAssignment          @relation(fields: [assignmentId, groupId], references: [id, groupId], onDelete: Cascade)
  enrollment AcademyEnrollment          @relation(fields: [groupId, studentId], references: [groupId, studentId], onDelete: NoAction, onUpdate: NoAction)
  student    User                       @relation("AcademySubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  attempts   AcademySubmissionAttempt[]
  grade      AcademyGrade?

  @@unique([assignmentId, studentId])
  @@unique([id, assignmentId])
  @@index([studentId])
}

/// Göndərilmiş cəhd — dəyişməz (cavablar AcademySubmissionItem-də, UPDATE trigger ilə qadağandır).
/// Yalnız qiymətləndirmə sahələri (evaluation*, autoScoreCenti) sonradan yazıla bilər.
model AcademySubmissionAttempt {
  id                String                  @id @default(cuid())
  submissionId      String
  assignmentId      String
  attemptNumber     Int
  assignmentVersion Int
  submittedAt       DateTime                @default(now())
  isLate            Boolean                 @default(false)
  idempotencyKey    String
  evaluationStatus  AcademyEvaluationStatus @default(NOT_APPLICABLE)
  autoScoreCenti    Int?
  evaluatedAt       DateTime?
  createdAt         DateTime                @default(now())

  submission      AcademySubmission       @relation(fields: [submissionId, assignmentId], references: [id, assignmentId], onDelete: Cascade)
  answers         AcademySubmissionItem[]
  selectedByGrade AcademyGrade[]          @relation("AcademyGradeSelectedAttempt")

  @@unique([submissionId, attemptNumber])
  @@unique([submissionId, idempotencyKey])
  @@unique([id, assignmentId])
  @@unique([id, submissionId])
}

/// Bir cəhddə bir elementin cavabı. (attemptId, assignmentId) və (itemId, assignmentId) kompozit açarları
/// cavabın başqa tapşırığın elementinə istinad etməsini bazada qeyri-mümkün edir.
model AcademySubmissionItem {
  id                   String                  @id @default(cuid())
  attemptId            String
  assignmentId         String
  itemId               String
  kind                 AcademyItemKind
  textAnswer           String?
  codeAnswer           String?
  linkUrl              String?
  learningSubmissionId String?
  evaluationStatus     AcademyEvaluationStatus @default(NOT_APPLICABLE)
  evaluationTrust      AcademyEvaluationTrust?
  evaluationPassed     Boolean?
  evaluationScoreCenti Int?
  evidenceAt           DateTime?
  createdAt            DateTime                @default(now())

  attempt            AcademySubmissionAttempt @relation(fields: [attemptId, assignmentId], references: [id, assignmentId], onDelete: Cascade)
  item               AcademyAssignmentItem    @relation(fields: [itemId, assignmentId], references: [id, assignmentId], onDelete: Restrict)
  learningSubmission Submission?              @relation("AcademyEvidence", fields: [learningSubmissionId], references: [id], onDelete: SetNull)
  files              AcademyFile[]            @relation("AcademyAnswerFiles")

  @@unique([attemptId, itemId])
}

/// Hələ göndərilməmiş cavablar (cəhd sayılmır)
model AcademySubmissionDraft {
  id           String   @id @default(cuid())
  assignmentId String
  groupId      String
  studentId    String
  answers      Json
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  assignment AcademyAssignment @relation(fields: [assignmentId, groupId], references: [id, groupId], onDelete: Cascade)
  enrollment AcademyEnrollment @relation(fields: [groupId, studentId], references: [groupId, studentId], onDelete: NoAction, onUpdate: NoAction)
  student    User              @relation("AcademyDraftStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

/// Fayl: tapşırıq resursu (müəllim) və ya göndərişin faylı (tələbə). Daxili açar generasiya olunur,
/// orijinal ad yalnız metadata. Fayl açıq URL ilə verilmir — icazəli endpoint-dən.
model AcademyFile {
  id               String             @id @default(cuid())
  purpose          AcademyFilePurpose
  status           AcademyFileStatus  @default(STAGED)
  assignmentId     String?
  submissionItemId String?
  ownerId          String?
  storageKey       String             @unique
  originalFilename String
  sizeBytes        Int
  mimeType         String
  sha256           String
  createdAt        DateTime           @default(now())
  attachedAt       DateTime?

  assignment     AcademyAssignment?     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissionItem AcademySubmissionItem? @relation("AcademyAnswerFiles", fields: [submissionItemId], references: [id], onDelete: Cascade)
  owner          User?                  @relation("AcademyFileOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([assignmentId])
}

/// Göndərişin cari qiyməti (göndəriş başına bir). selectedAttemptId yalnız bu göndərişin cəhdi ola bilər.
model AcademyGrade {
  id                String             @id @default(cuid())
  submissionId      String             @unique
  assignmentId      String
  selectedAttemptId String?
  rawScoreCenti     Int                @default(0)
  latePenaltyCenti  Int                @default(0)
  finalScoreCenti   Int                @default(0)
  feedback          String?
  status            AcademyGradeStatus @default(DRAFT)
  gradedById        String?
  gradedAt          DateTime?
  releasedAt        DateTime?
  version           Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  submission      AcademySubmission         @relation(fields: [submissionId, assignmentId], references: [id, assignmentId], onDelete: Cascade)
  selectedAttempt AcademySubmissionAttempt? @relation("AcademyGradeSelectedAttempt", fields: [selectedAttemptId, submissionId], references: [id, submissionId], onDelete: NoAction, onUpdate: NoAction)
  gradedBy        User?                     @relation("AcademyGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  itemScores      AcademyGradeItem[]
  rubricScores    AcademyRubricScore[]
  history         AcademyGradeHistory[]

  @@unique([id, assignmentId])
  @@unique([submissionId, assignmentId])
  @@index([assignmentId, status])
}

model AcademyGradeItem {
  id           String  @id @default(cuid())
  gradeId      String
  assignmentId String
  itemId       String
  scoreCenti   Int
  comment      String?

  grade AcademyGrade          @relation(fields: [gradeId, assignmentId], references: [id, assignmentId], onDelete: Cascade)
  item  AcademyAssignmentItem @relation(fields: [itemId, assignmentId], references: [id, assignmentId], onDelete: Cascade)

  @@unique([gradeId, itemId])
}

model AcademyGradeHistory {
  id                 String              @id @default(cuid())
  gradeId            String
  previousScoreCenti Int?
  newScoreCenti      Int?
  previousStatus     AcademyGradeStatus?
  newStatus          AcademyGradeStatus
  reason             String?
  snapshot           Json?
  changedById        String?
  changedAt          DateTime            @default(now())

  grade     AcademyGrade @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  changedBy User?        @relation("AcademyGradeChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([gradeId, changedAt])
}

model AcademyRubric {
  id            String   @id @default(cuid())
  assignmentId  String   @unique
  title         String
  maxScoreCenti Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignment AcademyAssignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  criteria   AcademyRubricCriterion[]

  @@unique([id, assignmentId])
}

model AcademyRubricCriterion {
  id            String @id @default(cuid())
  rubricId      String
  assignmentId  String
  title         String
  description   String @default("")
  maxScoreCenti Int
  sortOrder     Int    @default(0)

  rubric AcademyRubric        @relation(fields: [rubricId, assignmentId], references: [id, assignmentId], onDelete: Cascade)
  scores AcademyRubricScore[]

  @@unique([id, assignmentId])
}

model AcademyRubricScore {
  id           String  @id @default(cuid())
  gradeId      String
  assignmentId String
  criterionId  String
  scoreCenti   Int
  comment      String?

  grade     AcademyGrade           @relation(fields: [gradeId, assignmentId], references: [id, assignmentId], onDelete: Cascade)
  criterion AcademyRubricCriterion @relation(fields: [criterionId, assignmentId], references: [id, assignmentId], onDelete: Cascade)

  @@unique([gradeId, criterionId])
}

model AcademyClassSession {
  id           String             @id @default(cuid())
  groupId      String
  title        String
  description  String             @default("")
  instructorId String?
  startsAt     DateTime
  endsAt       DateTime
  meetingUrl   String?
  status       AcademyClassStatus @default(SCHEDULED)
  seriesId     String?
  createdById  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  group      AcademyGroup        @relation(fields: [groupId], references: [id], onDelete: Restrict)
  instructor User?               @relation("AcademySessionInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  createdBy  User?               @relation("AcademySessionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attendance AcademyAttendance[]

  @@unique([id, groupId])
  @@index([groupId, startsAt])
}

/// Davamiyyət: (sessionId, groupId) və (groupId, studentId) açarları — tələbə dərsin qrupuna yazılmalıdır
model AcademyAttendance {
  id         String                  @id @default(cuid())
  sessionId  String
  groupId    String
  studentId  String
  status     AcademyAttendanceStatus
  note       String?
  markedById String?
  markedAt   DateTime                @default(now())
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  session    AcademyClassSession @relation(fields: [sessionId, groupId], references: [id, groupId], onDelete: Cascade)
  enrollment AcademyEnrollment   @relation(fields: [groupId, studentId], references: [groupId, studentId], onDelete: NoAction, onUpdate: NoAction)
  student    User                @relation("AcademyAttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  markedBy   User?               @relation("AcademyAttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

/// Akademiya bildirişi (zəng menyusunda mövcud bildirişlərlə birlikdə). dedupeKey təkrarı bazada önləyir.
model AcademyNotification {
  id            String    @id @default(cuid())
  userId        String
  type          String
  title         String
  body          String?
  url           String?
  referenceType String?
  referenceId   String?
  dedupeKey     String
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  user User @relation("AcademyNotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}

/// Tranzaksion outbox: domen dəyişikliyi ilə eyni tranzaksiyada yazılır, işçi bildirişlərə çevirir (təkrar cəhd ilə)
model AcademyOutboxEvent {
  id          String              @id @default(cuid())
  type        String
  payload     Json
  status      AcademyOutboxStatus @default(PENDING)
  attempts    Int                 @default(0)
  availableAt DateTime            @default(now())
  lastError   String?
  createdAt   DateTime            @default(now())
  processedAt DateTime?

  @@index([status, availableAt])
}
