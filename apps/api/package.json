{
  "name": "@dacy/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/with-env.mjs jest --config jest.config.cjs",
    "test:e2e": "node scripts/with-env.mjs jest --config jest-e2e.config.cjs --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/with-env.mjs prisma migrate dev",
    "prisma:deploy": "node scripts/with-env.mjs prisma migrate deploy",
    "prisma:seed": "node scripts/with-env.mjs tsx prisma/seed.ts",
    "prisma:reset": "node scripts/with-env.mjs prisma migrate reset --force",
    "prisma:studio": "node scripts/with-env.mjs prisma studio",
    "recompute-progress": "node scripts/with-env.mjs tsx src/scripts/recompute-progress.ts",
    "postinstall": "prisma generate",
    "check:python:native": "node scripts/with-env.mjs tsx scripts/check-native-python.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dacy/shared": "workspace:*",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-ws": "^11.2.8",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.2.8",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "adm-zip": "^0.6.1",
    "cookie-parser": "^1.4.7",
    "dejavu-fonts-ttf": "^2.37.3",
    "dockerode": "^4.0.12",
    "helmet": "^8.1.0",
    "js-yaml": "^5.4.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/adm-zip": "^0.5.8",
    "@types/cookie-parser": "^1.4.9",
    "@types/dockerode": "^3.3.47",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.2",
    "jest": "^30.2.0",
    "prisma": "^6.19.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
